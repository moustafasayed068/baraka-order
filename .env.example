# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_, never import from client components.
SUPABASE_SERVICE_ROLE_KEY=

# Online payment (Paymob). Leave empty to keep cash only; checkout shows "online payment" once all are set.
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_PUBLIC_KEY=
# comma-separated integration ids from the Paymob dashboard (card, mobile wallet, …)
PAYMOB_INTEGRATION_IDS=
# public https address of this site; Paymob sends webhooks to $APP_URL/api/paymob/webhook
APP_URL=

# Local only: show the online-payment option and pay page without Paymob keys (dev server only)
PAYMOB_PREVIEW=
